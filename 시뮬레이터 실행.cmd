@echo off
setlocal
cd /d "%~dp0"
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command ^
  "$ErrorActionPreference='Stop'; $simRoot=Get-Location; $simUrl='http://127.0.0.1:5175/'; function Get-SimulatorState { try { $response=Invoke-WebRequest -UseBasicParsing -Uri $simUrl -TimeoutSec 1 } catch { return 'offline' }; if ($response.Content -match '<title>Asset Simulator</title>') { return 'ready' }; return 'occupied' }; try { $state=Get-SimulatorState; if ($state -eq 'occupied') { throw 'Port 5175 is being used by another application. Close that application and try again.' }; if ($state -ne 'ready') { if (-not (Get-Command npm.cmd -ErrorAction SilentlyContinue)) { throw 'Node.js / npm was not found. Install Node.js and try again.' }; if (-not (Test-Path -LiteralPath (Join-Path $simRoot 'node_modules/vite/bin/vite.js'))) { throw 'Dependencies were not found. Run npm.cmd install in this folder first.' }; $server=Start-Process -FilePath $env:ComSpec -ArgumentList '/d /c npm.cmd run dev -- --port 5175 --strictPort' -WorkingDirectory $simRoot -WindowStyle Hidden -PassThru; for ($attempt=0; $attempt -lt 30; $attempt++) { Start-Sleep -Milliseconds 500; $state=Get-SimulatorState; if ($state -eq 'ready') { break }; if ($state -eq 'occupied') { throw 'Port 5175 is being used by another application.' }; if ($server.HasExited) { throw 'The simulator server could not start. Run npm.cmd run dev -- --port 5175 --strictPort to see the error.' } }; if ($state -ne 'ready') { throw 'The simulator did not respond in time. Try again or run the server command manually.' } }; Start-Process $simUrl; exit 0 } catch { Write-Host ('Simulator launch failed: ' + $_.Exception.Message) -ForegroundColor Red; exit 1 }"
if errorlevel 1 pause
endlocal
